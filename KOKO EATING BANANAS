class Solution {
    public int minEatingSpeed(int[] piles, int h) {
        int low = 1;
        int high = findMax(piles);
        int answer = 0;
        while(low<=high) {
            int mid = low+(high-low)/2;
            if (isPossible(piles, h, mid)){
                answer = mid;
                high = mid-1;
            }
            else {
                low = mid+1;
            }
        }
        return answer;
    }

    public static int findMax(int[] piles) {
        int max = piles[0];
        for(int pile:piles) {
            if(pile>max){
                max = pile;
            }
        }
        return max;
    }

    public static boolean isPossible(int[] piles, int h, int speed) {
        int thrs = 0;
        for(int pile:piles) {
            thrs += (pile + speed -1)/speed;
            if(thrs>h) {
                return false;
            }
        }
        return true;
    }
}
